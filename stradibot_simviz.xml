<redisConfiguration namespacePrefix="opensai" />

<simvizConfiguration
	worldFilePath="cs225a/project_starter/stradibot/urdf_models/world_stradibot.urdf">

	<simParameters frictionCoefficient="0.5" />

	<logger logFolderName="log_files/stradibot/simviz"
		enabledAtStartup="true"
		addTimestampToFilename="false" />

	<forceSensor robotOrObjectName="flexiv"
		linkName="bow"
		filterCutoff="5.0">
        <origin xyz="0.0 0.05 0.0" 
                rpy="0 0 0" />
    </forceSensor>


</simvizConfiguration>

<robotControlConfiguration robotName="flexiv"
	robotModelFile="cs225a/project_starter/stradibot/urdf_models/flexiv_violin/flexiv.urdf">

	<logger logFolderName="log_files/stradibot/controllers"
		enabledAtStartup="true"
		addTimestampToFilename="false" />

	<controller name="cartesian_controller">
		<motionForceTask name="cartesian_task"
			linkName="flange"
			parametrizationInCompliantFrame="false">
			<compliantFrame xyz="-0.35 0 0.05" rpy="0 0 0" />
			<velocitySaturation enabled="true" />
			<otg type="disabled" />
		</motionForceTask>

		<jointTask name="joint_task">
			<otg type="disabled" />
		</jointTask>
	</controller>

	<controller name="joint_controller">
		<jointTask name="joint_task">
			<velocitySaturation enabled="true" />
			<otg type="disabled" />
		</jointTask>
	</controller>

</robotControlConfiguration>


<robotControlConfiguration robotName="violin"
	robotModelFile="cs225a/project_starter/stradibot/urdf_models/flexiv_violin/violin.urdf">

	<logger logFolderName="log_files/stradibot/controllers"
		enabledAtStartup="true"
		addTimestampToFilename="false" />

	<controller name="cartesian_controller">
		<motionForceTask name="cartesian_task"
			linkName="fake_link"
            parametrizationInCompliantFrame="false">
			<velocitySaturation enabled="true" />
			<otg type="disabled" />
		</motionForceTask>

		<jointTask name="joint_task">
			<otg type="disabled" />
		</jointTask>
	</controller>

	<controller name="joint_controller">
		<jointTask name="joint_task">
			<velocitySaturation enabled="true" />
			<otg type="disabled" />
		</jointTask>
	</controller>

</robotControlConfiguration>

